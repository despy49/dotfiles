[Unit]
Description=SSH Dynamic SOCKS Proxy Tunnel
After=network.target network-online.target graphical-session.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
ExecStart=/usr/bin/ssh -N -D 127.0.0.1:8081 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 escape-from-matrix
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
