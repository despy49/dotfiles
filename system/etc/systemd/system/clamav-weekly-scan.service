[Unit]
Description=Weekly ClamAV System Scan
After=local-fs.target clamav-daemon.service
Wants=clamav-daemon.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/clamav_weekly_scan.sh
Nice=15
CPUSchedulingPolicy=other
IOSchedulingClass=2
IOSchedulingPriority=7
CPUQuota=200%

