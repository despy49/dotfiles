[Unit]
Description=GOST HTTP to SOCKS5 Proxy Bridge (System level)
After=network.target escape-from-matrix.service
Requires=escape-from-matrix.service

[Service]
Type=simple
User=glitch
Group=glitch
ExecStart=/usr/bin/gost -L=http://127.0.0.1:8888 -F=socks5://127.0.0.1:8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

