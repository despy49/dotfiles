#!/bin/sh
# add binaries to PATH if they aren't added yet
# affix colons on either side of $PATH to simplify matching
case ":${PATH}:" in
    *:"$HOME/.local/bin":*)
        ;;
    *)
        # Prepending path in case a system-installed binary needs to be overridden
        export PATH="$HOME/.local/bin:$PATH"
        ;;
esac

export NPM_CONFIG_USERCONFIG="$HOME/.config/npm/npmrc"
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nvidia"
export _JAVA_OPTIONS="-Djava.util.prefs.userRoot=$XDG_DATA_HOME/java"
export PUB_CACHE="$HOME/.local/share/pub-cache"
export GNUPGHOME="$HOME/.local/share/gnupg"
export __GL_SHADER_DISK_CACHE_PATH="$HOME/.cache/nvidia"
export CORTEX_DEBUG_LOG_DIR="$HOME/.cache/cortex-debug"
export DEBUGPY_LOG_DIR="$HOME/.cache/cortex-debug"
export CORTEX_DEBUG_CACHE_DIR="$HOME/.cache"
export VIMINIT="set viminfofile=$XDG_CACHE_HOME/viminfo | source $HOME/.vimrc"

# === NATIVE XDG BASE DIRECTORY SPECIFICATION ===
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"

# === THIRD-PARTY RUNTIME FIXES (GUI & CLI COMPLIANT) ===
export CORTEX_DEBUG_LOG_DIR="$XDG_CACHE_HOME/cortex-debug"
export DEBUGPY_LOG_DIR="$XDG_CACHE_HOME/cortex-debug"
export CORTEX_DEBUG_CACHE_DIR="$XDG_CACHE_HOME"
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export FVM_HOME="$XDG_DATA_HOME/fvm"
